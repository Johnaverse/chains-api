{
  "name": "Chains — Blockchain Network Analytics",
  "short_name": "Chains",
  "description": "Live operator and RPC-provider incidents joined to the chains they affect, L2 scaling, chain relationships and RPC health.",
  "id": "./",
  "start_url": "./",
